# Copiar como ia/.env y completar. Se usa con:
#   docker compose --env-file ia/.env -f compose.integration.yaml up --build -d --wait
# ia/.env está excluido de git; no incluir valores reales en este archivo.

# Obligatoria: clave de Gemini para generación y crítico (AI Core).
GOOGLE_API_KEY=
# Opcional: clave propia para ingesta y clasificación (Data/IA). Vacía = usa GOOGLE_API_KEY.
# Para que sume cuota debe pertenecer a otro proyecto de Google AI Studio.
DATAIA_GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Respaldo ante 503 (sobrecarga) o 429 (cuota): otros modelos Gemini, con cuota propia, separados por coma
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Opcional: último respaldo para generador y crítico (https://console.groq.com/).
# Gratis: 8.000 tokens por minuto por modelo; cada rol prueba sus modelos en orden.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b,openai/gpt-oss-120b
GROQ_CRITIC_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b

# Límites de contenido (413 DOCUMENTO_DEMASIADO_EXTENSO) y de transporte (bytes).
# Pensados para cuentas gratuitas: todo documento aceptado entra completo en el contexto.
IA_MAX_PAGINAS=50
IA_MAX_TOKENS_DOCUMENTO=24000
IA_MAX_DOCUMENT_BYTES=26214400

# Tiempos y reintentos del proveedor
IA_PROVIDER_TIMEOUT_SECONDS=60
IA_PROVIDER_MAX_RETRIES=1
IA_PIPELINE_TIMEOUT_SECONDS=480
IA_HTTP_TIMEOUT_SECONDS=600

# Contexto y clasificación
IA_CONTEXTO_PRESUPUESTO_TOKENS=24000
DATAIA_ENRICH_BATCH_SIZE=15
DATAIA_ENRICH_CONCURRENCY=4
DATAIA_ENRICH_MAX_CHARS=120000
DATAIA_EMBEDDINGS_ENABLED=false
