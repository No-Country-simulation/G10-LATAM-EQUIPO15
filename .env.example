# Variables de entorno de ejemplo
# No incluir valores reales ni secretos.

# Backend
BACKEND_PORT=8000
OCI_BUCKET_NAME=nuevamente-contenidos-educativos

# Frontend (Compose de integración: Backend 18002 y Frontend 18003 por defecto)
FRONTEND_PORT=18003

# Object Storage opcional; activar únicamente tras configurar el acceso real.
OCI_STORAGE_ENABLED=false
OCI_NAMESPACE=
OCI_REGION=
OCI_AUTH_MODE=api_key
OCI_CONFIG_FILE=/run/secrets/oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_HTTP_TIMEOUT_SECONDS=10
# Historial por navegador: requiere OCI. En despliegues HTTPS, activar Secure
# explícitamente aunque el TLS termine en un proxy delante de Nginx.
HISTORY_ENABLED=true
HISTORY_COOKIE_SECURE=false
# OCI_CREDENTIALS_DIRECTORY debe apuntar a una carpeta privada fuera del repo.
