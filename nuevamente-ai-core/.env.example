# ===================================================
# NUEVAMENTE AI CORE - VARIABLES DE ENTORNO
# Para el servicio completo con Docker, usar ia/.env.example.
# No incluir valores reales en este archivo.
# ===================================================

# Proveedor Primario de LLM (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Proveedor de Respaldo (Groq Cloud): se usa solo si GROQ_API_KEY tiene valor.
# Obtén tu clave en: https://console.groq.com/
GROQ_API_KEY=
# llama-3.3-70b-versatile ya no está disponible en Groq
GROQ_MODEL=openai/gpt-oss-20b,openai/gpt-oss-120b
GROQ_CRITIC_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b

# Selección de Proveedor Activo: "gemini" o "groq"
LLM_PROVIDER=gemini

# Vector store y embeddings (los embeddings son opcionales; la generación no los usa)
CHROMADB_DIR=./.chromadb_data
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
DATAIA_EMBEDDINGS_ENABLED=false

# Parámetros del Agente Crítico
UMBRAL_ANCLAJE_MINIMO=0.85
MAX_INTENTOS_GENERACION=2
