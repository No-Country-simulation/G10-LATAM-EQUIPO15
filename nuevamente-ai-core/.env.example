# ===================================================
# NUEVAMENTE AI CORE - VARIABLES DE ENTORNO
# ===================================================

# Proveedor Primario de LLM (Google AI Studio)
GEMINI_API_KEY=tu_clave_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# Proveedor de Respaldo / Failover de Alta Velocidad (Groq Cloud)
# Obtén tu clave en: https://console.groq.com/
GROQ_API_KEY=tu_clave_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Selección de Proveedor Activo: "gemini" o "groq"
LLM_PROVIDER=gemini

# Configuración de Embeddings y Vector Store
CHROMA_PERSIST_DIRECTORY=./chroma_db
EMBEDDINGS_MODEL=models/text-embedding-004

# Parámetros del Agente Crítico
UMBRAL_ANCLAJE_MINIMO=0.85
MAX_REINTENTOS_CALIDAD=2
